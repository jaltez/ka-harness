//! Screen-reader rendering (TUI-13): the `/plain` view. Everything is
//! plain text lines — no glyphs, no boxes, no color-dependency — with
//! structure carried by prefixes (`user:`, `ka:`, `tool: … → ok`) and
//! a blank line between blocks so linear navigation stays legible.
//! Session toggle; the decorated renderer is untouched.

use crate::tui::{Line, Meters, Modal, PendingAsk, ToolCall, Transcript};

/// The whole transcript as plain text rows: one block per entry, a
/// blank row between entries (screen readers read them as pauses).
pub fn transcript_rows(transcript: &Transcript) -> Vec<String> {
    let mut out = Vec::new();
    for entry in transcript.entries() {
        match entry {
            Line::User(text) => {
                out.push(format!("user: {text}"));
            }
            Line::Assistant(text) => {
                // the assistant speaks plainly; multi-line text keeps
                // its own lines
                for line in text.lines() {
                    out.push(line.to_string());
                }
            }
            Line::Thought(text) => {
                for (i, line) in text.lines().enumerate() {
                    if i == 0 {
                        out.push(format!("thinking: {line}"));
                    } else {
                        out.push(line.to_string());
                    }
                }
            }
            Line::ToolBlock(calls) => {
                for call in calls {
                    out.push(tool_row(call));
                }
            }
            Line::Info(note) => out.push(format!("note: {note}")),
            Line::Warn(note) => out.push(format!("warning: {note}")),
            Line::Err(note) => out.push(format!("error: {note}")),
            Line::Report(msg) => {
                if !msg.is_empty() {
                    out.push(msg.clone());
                }
            }
            Line::Shell(text) => {
                for (i, line) in text.lines().enumerate() {
                    if i == 0 {
                        out.push(format!("shell: {line}"));
                    } else {
                        out.push(line.to_string());
                    }
                }
            }
            Line::Summary {
                tone, text, detail, ..
            } => {
                let verdict = match tone {
                    crate::tui::SummaryTone::Ok => "done",
                    crate::tui::SummaryTone::Warn => "done (with warnings)",
                    crate::tui::SummaryTone::Err => "failed",
                };
                // the verdict text already opens with its verdict: say it once
                let head = text.split_whitespace().next().unwrap_or("");
                let same = match tone {
                    crate::tui::SummaryTone::Ok => head == "done",
                    crate::tui::SummaryTone::Warn => head == "done" || head == "aborted",
                    crate::tui::SummaryTone::Err => head == "failed",
                };
                if same {
                    out.push(text.clone());
                } else {
                    out.push(format!("{verdict}: {text}"));
                }
                if let Some(d) = detail {
                    for line in d.lines() {
                        out.push(line.to_string());
                    }
                }
            }
        }
        out.push(String::new());
    }
    out
}

/// One tool call as `tool: {name} {args} → {status}: {first output}`.
pub fn tool_row(call: &ToolCall) -> String {
    // the live header shape is `→ {tool} · {detail}`; parse it back
    let head = call.head.trim().strip_prefix("→ ").unwrap_or(&call.head);
    let (name, detail) = match head.split_once(" · ") {
        Some((n, d)) => (n.trim(), d.trim()),
        None => (head.trim(), ""),
    };
    let status = if call.ok { "ok" } else { "failed" };
    let mut row = format!("tool: {name}");
    if !detail.is_empty() {
        row.push_str(&format!(" {detail}"));
    }
    row.push_str(&format!(" → {status}"));
    if !call.note.is_empty() {
        row.push_str(&format!(": {}", call.note));
    }
    row
}

/// The status line as one plain sentence.
pub fn status_text(meters: &Meters) -> String {
    let mut parts = Vec::new();
    if !meters.mode.is_empty() {
        parts.push(format!("mode {}", meters.mode));
    }
    let (used, window) = meters.context;
    if window > 0 {
        parts.push(format!(
            "ctx {}%",
            (used as f64 / window as f64 * 100.0) as u64
        ));
    } else if used > 0 {
        parts.push(format!("ctx ~{used} tok"));
    }
    parts.push(format!("${:.4}", meters.cost));
    if meters.turns > 0 {
        parts.push(format!("{} turns", meters.turns));
    }
    if let Some(pill) = crate::roster::pill_from_counts((
        meters.jobs.tasks as usize,
        meters.jobs.jobs as usize,
        meters.jobs.dap as usize,
    )) {
        parts.push(pill);
    }
    parts.join(" · ")
}

/// A modal (or the permission ask) as `(title, rows)` in plain text.
/// Selected rows carry a `>` marker; section headers stay plain text.
/// `width` only bounds the help table layout.
pub fn modal_lines(
    modal: &Modal,
    width: usize,
    _sidebar: &crate::tui::SidebarState,
) -> (String, Vec<String>) {
    let marker = |i: usize, selected: usize| if i == selected { ">" } else { " " };
    match modal {
        Modal::Session(picker) => {
            let mut rows = if picker.filter.is_empty() {
                Vec::new()
            } else {
                vec![format!("filter: {}", picker.filter)]
            };
            for (i, (label, detail)) in picker.rows().into_iter().enumerate() {
                rows.push(format!(
                    "{} {label}  —  {detail}",
                    marker(i, picker.selected)
                ));
            }
            ("sessions".into(), rows)
        }
        Modal::Settings(p) => {
            let mut rows = vec![
                format!(
                    "{} model: {}",
                    marker(0, p.selected),
                    p.edit.clone().unwrap_or_else(|| p.model.clone())
                ),
                format!(
                    "{} mode: {}",
                    marker(1, p.selected),
                    crate::tui::mode_label(p.mode)
                ),
                format!(
                    "{} effort: {}",
                    marker(2, p.selected),
                    p.effort
                        .map(|e| format!("{e:?}"))
                        .unwrap_or_else(|| "provider default".into())
                ),
                String::new(),
                format!("config: {}", p.config_path),
            ];
            if let Some(status) = &p.status {
                rows.push(status.clone());
            }
            ("settings".into(), rows)
        }
        Modal::Features {
            entries,
            selected,
            status,
        } => {
            let mut rows = Vec::new();
            for (i, row) in entries.iter().enumerate() {
                if row.header {
                    rows.push(row.label.clone());
                } else {
                    rows.push(format!(
                        "{} {} {}",
                        marker(i, *selected),
                        if row.on { "on " } else { "off" },
                        row.label
                    ));
                }
            }
            if let Some(status) = status {
                rows.push(status.clone());
            }
            ("features".into(), rows)
        }
        Modal::Model(picker) => {
            let mut rows = if picker.filter.is_empty() {
                Vec::new()
            } else {
                vec![format!("filter: {}", picker.filter)]
            };
            for (i, m) in picker.models.iter().enumerate() {
                let key = if m.key_env.is_empty() {
                    String::new()
                } else if m.key_set {
                    " key ok".into()
                } else {
                    format!(" key missing ({})", m.key_env)
                };
                rows.push(format!(
                    "{} {} ({} tok){key}",
                    marker(i, picker.selected),
                    m.id,
                    m.context
                ));
            }
            ("models".into(), rows)
        }
        Modal::Provider(picker) => {
            let rows: Vec<String> = picker
                .rows()
                .into_iter()
                .enumerate()
                .map(|(i, (p, note))| format!("{} {} {}", marker(i, picker.selected), p.name, note))
                .collect();
            ("providers".into(), rows)
        }
        Modal::Key(p) => (
            "api key".into(),
            vec![
                format!("provider: {}", p.provider),
                format!("key var: {}", p.env_var),
                (p.doc_url.is_empty())
                    .then(String::new)
                    .unwrap_or_else(|| format!("get one: {}", p.doc_url)),
                format!("key input: {} chars", p.input.chars().count()),
                String::new(),
                "type the key, enter saves, esc cancels".into(),
            ],
        ),
        Modal::Spills { items, selected } => list("spills", items, *selected, marker),
        Modal::Prompts { items, selected } => list("mcp prompts", items, *selected, marker),
        Modal::Rewind { items, selected } => {
            let rows: Vec<String> = items
                .iter()
                .enumerate()
                .map(|(i, (turns, prompt))| format!("{} [-{turns}] {prompt}", marker(i, *selected)))
                .collect();
            ("rewind".into(), rows)
        }
        Modal::PromptActions {
            turns,
            prompt,
            selected,
        } => {
            let rows = vec![
                format!("\"{prompt}\"  [-{turns}]"),
                format!(
                    "{} rewind here — cut -{turns} turn(s) (r)",
                    marker(0, *selected)
                ),
                format!(
                    "{} rewind & edit — cut, then resend this prompt (e)",
                    marker(1, *selected)
                ),
                format!(
                    "{} fork here — branch a copy, original stays intact (f)",
                    marker(2, *selected)
                ),
            ];
            ("rewind".into(), rows)
        }
        Modal::Memory {
            rows,
            inbox,
            selected,
        } => {
            let mut out = rows.clone();
            if !inbox.is_empty() {
                out.push(String::new());
                out.push("staged inbox (.ka/memory/inbox.md)".into());
                for (i, note) in inbox.iter().enumerate() {
                    out.push(format!("{} {note}", marker(i, *selected)));
                }
                out.push(String::new());
                out.push("enter accepts to project memory · u to user · d discards".into());
            }
            ("memory".into(), out)
        }
        Modal::Usage { rows } => ("usage".into(), rows.clone()),
        Modal::Context { rows } => ("context".into(), rows.clone()),
        Modal::Tree {
            items,
            selected,
            actions: _,
        } => list("fork tree", items, *selected, marker),
        Modal::Tasks {
            entries,
            selected,
            previews,
        } => {
            let mut rows = Vec::new();
            for (i, (id, row)) in entries.iter().enumerate() {
                rows.push(format!("{} {row}", marker(i, *selected)));
                if let Some((_, preview)) =
                    id.and_then(|id| previews.iter().find(|(pid, _)| *pid == id))
                {
                    rows.push(format!("    result: {preview}"));
                }
            }
            ("tasks".into(), rows)
        }
        Modal::TaskDetail { id, text, .. } => {
            let mut rows = vec![format!("task t-{id} (enter closes · arrows scroll)")];
            rows.extend(text.lines().map(str::to_string));
            (format!("task t-{id}"), rows)
        }
        Modal::Debug { rows, .. } => ("debug sessions".into(), rows.clone()),
        Modal::Todos { rows } => ("todos".into(), rows.iter().map(flatten_line).collect()),
        Modal::Skills { rows } => ("inventory".into(), rows.iter().map(flatten_line).collect()),
        Modal::Info { rows } => (
            "session info".into(),
            rows.iter().map(flatten_line).collect(),
        ),
        Modal::Help { .. } => {
            let rows = crate::tui::help_modal_rows(width);
            ("help".into(), rows.iter().map(flatten_line).collect())
        }
        Modal::Theme { names, selected } => {
            let mut rows = vec![format!("{} default (Nocturne)", marker(0, *selected))];
            for (i, name) in names.iter().enumerate() {
                rows.push(format!("{} {name}", marker(i + 1, *selected)));
            }
            ("theme".into(), rows)
        }
        Modal::Style { names, selected } => {
            let mut rows = vec![format!("{} built-in identity", marker(0, *selected))];
            for (i, name) in names.iter().enumerate() {
                rows.push(format!("{} {name}", marker(i + 1, *selected)));
            }
            ("style".into(), rows)
        }
        Modal::CopyPick {
            blocks,
            selected,
            save,
        } => {
            let mut rows = Vec::new();
            if let Some(path) = save {
                rows.push(format!("save to: {path} (type the path, enter writes)"));
                rows.push(String::new());
            }
            for (i, (role, text)) in blocks.iter().enumerate() {
                rows.push(format!("{} {role}:", marker(i, *selected)));
                for line in text.lines() {
                    rows.push(line.to_string());
                }
                rows.push(String::new());
            }
            ("copy".into(), rows)
        }
        Modal::Search {
            query,
            hits,
            selected,
        } => {
            let mut rows = vec![format!("query: {query}")];
            for (i, (row, snippet)) in hits.iter().enumerate() {
                rows.push(format!("{} [{row}] {snippet}", marker(i, *selected)));
            }
            ("search".into(), rows)
        }
        Modal::Changelog { rows, .. } => ("changelog".into(), rows.clone()),
        Modal::Queue { items, selected } => list("queue", items, *selected, marker),
        Modal::Hooks { rows, .. } => ("hooks".into(), rows.clone()),
        Modal::Permissions { rows, .. } => ("permissions".into(), rows.clone()),
        Modal::Doctor { rows, .. } => ("doctor".into(), rows.clone()),
        // GIT-04: the panel as text — header counts, marked file rows
        // (or the keymap), the diff body, or the commit draft
        Modal::Git {
            files,
            selected,
            pane,
            scroll: _,
            draft,
            keys_shown,
            note,
        } => {
            let mut rows = Vec::new();
            let staged = files.iter().filter(|f| f.staged()).count();
            rows.push(format!("{} staged of {} changed", staged, files.len()));
            match pane {
                crate::git::Pane::List if *keys_shown => {
                    rows.push("keys: ↑↓ choose · ⏎ diff · s stage/unstage · a all · c commit · ? close help · esc close".into());
                }
                crate::git::Pane::List => {
                    if files.is_empty() {
                        rows.push("(working tree clean)".into());
                    }
                    for (i, file) in files.iter().enumerate() {
                        rows.push(format!("{} {}", marker(i, *selected), file.row()));
                    }
                }
                crate::git::Pane::Diff { path, text } => {
                    rows.push(format!("diff: {path}"));
                    rows.extend(text.lines().map(str::to_string));
                }
                crate::git::Pane::Commit => {
                    for file in files.iter().filter(|f| f.staged()) {
                        rows.push(format!("  {}", file.row()));
                    }
                    rows.push(format!("message: {draft}"));
                }
            }
            if let Some(n) = note {
                rows.push(n.clone());
            }
            ("git".into(), rows)
        }
    }
}

/// The permission ask as plain lines: question, detail, numbered
/// options with the selection marker, and the deny hint.
pub fn ask_lines(ask: &PendingAsk) -> Vec<String> {
    let mut rows = vec![ask.question.clone()];
    if let Some(d) = &ask.detail {
        rows.push(String::new());
        rows.extend(d.lines().map(str::to_string));
    }
    rows.push(String::new());
    for (i, option) in ask.options.iter().enumerate() {
        let mark = if i == ask.selected { ">" } else { " " };
        rows.push(format!("{mark} {}. {option}", i + 1));
    }
    rows.push(String::new());
    rows.push("enter answers the marked option · esc denies".to_string());
    rows
}

fn list(
    title: &str,
    items: &[String],
    selected: usize,
    marker: impl Fn(usize, usize) -> &'static str,
) -> (String, Vec<String>) {
    let rows: Vec<String> = items
        .iter()
        .enumerate()
        .map(|(i, item)| format!("{} {item}", marker(i, selected)))
        .collect();
    (title.to_string(), rows)
}

/// Flatten one decorated row to its text (spans joined, styles gone).
fn flatten_line(line: &ratatui::text::Line<'_>) -> String {
    line.spans.iter().map(|s| s.content.as_ref()).collect()
}

#[cfg(test)]
mod tests {
    #![allow(clippy::unwrap_used, clippy::expect_used)]

    use super::*;
    use crate::tui::{SummaryTone, ToolCall};

    #[test]
    fn transcript_rows_prefix_each_block_kind() {
        let mut t = Transcript::default();
        t.push(Line::User("fix the bug".into()));
        t.push(Line::ToolBlock(vec![ToolCall {
            head: "→ bash · cargo test".into(),
            ok: true,
            note: "all green".into(),
            excerpt: String::new(),
            spill: None,
            dur: Some(1.0),
            expanded: false,
        }]));
        t.push(Line::Warn("refused".into()));
        t.push(Line::Summary {
            glyph: '✓',
            tone: SummaryTone::Ok,
            text: "2.1s · 1.2k in".into(),
            detail: None,
            expanded: false,
        });
        let rows = transcript_rows(&t);
        assert!(rows.contains(&"user: fix the bug".to_string()), "{rows:?}");
        assert!(
            rows.contains(&"tool: bash cargo test → ok: all green".to_string()),
            "{rows:?}"
        );
        assert!(rows.contains(&"warning: refused".to_string()), "{rows:?}");
        assert!(
            rows.contains(&"done: 2.1s · 1.2k in".to_string()),
            "{rows:?}"
        );
        // blank separators: every entry block ends with one
        assert_eq!(rows.iter().filter(|r| r.is_empty()).count(), 4);
    }

    #[test]
    fn status_text_carries_mode_cost_and_jobs() {
        let meters = Meters {
            mode: "allow".into(),
            context: (2000, 10_000),
            cost: 0.05,
            turns: 3,
            jobs: crate::tui::JobsPill {
                tasks: 1,
                jobs: 2,
                dap: 0,
            },
            ..Default::default()
        };
        let text = status_text(&meters);
        assert!(text.contains("mode allow"), "{text}");
        assert!(text.contains("ctx 20%"), "{text}");
        assert!(text.contains("$0.0500"), "{text}");
        assert!(text.contains("2 jobs"), "{text}");
    }

    #[test]
    fn ask_lines_number_options_with_marker() {
        let ask = PendingAsk {
            id: ka_protocol::AskId("q1".into()),
            question: "run cargo?".into(),
            options: vec!["allow".into(), "always".into(), "deny".into()],
            selected: 1,
            detail: None,
        };
        let rows = ask_lines(&ask);
        assert!(rows.contains(&"> 2. always".to_string()), "{rows:?}");
        assert!(rows.contains(&"  1. allow".to_string()), "{rows:?}");
        assert!(rows.contains(&"run cargo?".to_string()), "{rows:?}");
    }

    #[test]
    fn modal_lines_flatten_simple_lists() {
        let modal = Modal::Queue {
            items: vec!["first".into(), "second".into()],
            selected: 1,
        };
        let (title, rows) = modal_lines(&modal, 80, &crate::tui::SidebarState::default());
        assert_eq!(title, "queue");
        assert_eq!(rows[0], "  first");
        assert_eq!(rows[1], "> second");
    }

    /// A panel's status (`s` answered) rides the plain rows too, last.
    #[test]
    fn modal_lines_carry_a_panel_status() {
        use crate::tui::{FeatureRow, SettingsPanel};
        let sidebar = crate::tui::SidebarState::default();
        let rows = |modal: &Modal| modal_lines(modal, 80, &sidebar).1;
        let settings = |status: Option<&str>| {
            Modal::Settings(SettingsPanel {
                model: "zai/glm-5.3".into(),
                mode: ka_protocol::Mode::Ask,
                effort: None,
                selected: 0,
                edit: None,
                providers: Vec::new(),
                config_path: "/tmp/ka-config".into(),
                status: status.map(str::to_string),
            })
        };
        let features = |status: Option<&str>| Modal::Features {
            entries: vec![FeatureRow {
                spec: "agents".into(),
                label: "subagents".into(),
                header: false,
                on: true,
            }],
            selected: 0,
            status: status.map(str::to_string),
        };
        let saved = "saved settings to /home/u/.config/ka/ka.toml";
        assert_eq!(
            rows(&settings(None)).last(),
            Some(&"config: /tmp/ka-config".to_string())
        );
        assert_eq!(
            rows(&settings(Some(saved))).last(),
            Some(&saved.to_string())
        );
        assert_eq!(
            rows(&features(None)).last(),
            Some(&"> on  subagents".to_string())
        );
        assert_eq!(
            rows(&features(Some(saved))).last(),
            Some(&saved.to_string())
        );
    }
}
